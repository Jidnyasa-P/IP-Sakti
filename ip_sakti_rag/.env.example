# =============================================================================
# ip_sakti_rag_model/.env — copy to ip_sakti_rag_model/.env for local dev.
# On Render, set these in the service's Environment tab instead of a file.
# =============================================================================

# --- Gemini (embeddings via gemini-embedding-001 + answer generation) ---
# Free key from https://aistudio.google.com/apikey
# NOTE (2026-09): gemini-2.5-flash still works today but Google has it
# scheduled for shutdown on 2026-10-16 — don't build on it now. gemini-2.0-
# flash is already shut down (since 2026-06-01), which is what broke the
# original setup. gemini-3.1-flash-lite is the current stable, cheap,
# free-tier-eligible pick with no announced shutdown date; swap to
# gemini-3-flash-preview if you need more reasoning power and don't mind
# it being a preview model. Re-check https://ai.google.dev/gemini-api/docs/models
# before your demo either way — this list moves fast.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite

# --- Qdrant Cloud (from your Qdrant Cloud cluster's "Connect" panel) ---
QDRANT_URL=https://YOUR-CLUSTER-ID.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=legal_corpus_chunks

# --- Neo4j Aura (from the Aura console "Connection details") ---
# All three of URI/USER/PASSWORD must be set for graph.py to connect; if any
# is missing, graph enrichment is silently skipped (rest of the pipeline
# still works). Free tier auto-pauses after ~72h idle — first query after a
# pause will be slow while it wakes back up.
NEO4J_URI=neo4j+s://YOUR-INSTANCE-ID.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- MongoDB Atlas (same cluster/db your Node backend already uses) ---
MONGODB_URI=
MONGODB_DB_NAME=ip_sakti

# --- Bhashini (used ONLY for translating final answers / UI strings —
#     NOT used for retrieval, since embeddings are multilingual) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_INFERENCE_API_KEY=

# --- Shared secret so only your Node backend can call this microservice ---
RAG_SERVICE_SHARED_SECRET=change-me-in-production

PORT=8001
# --- Retrieval tuning ---
SEMANTIC_WEIGHT=0.65
KEYWORD_WEIGHT=0.35
TOP_K=5

# --- Safety thresholds ---
CONFIDENCE_HIGH_THRESHOLD=0.45
CONFIDENCE_MODERATE_THRESHOLD=0.28
CONFIDENCE_LOW_THRESHOLD=0.15
MIN_CHUNKS_FOR_HIGH_CONFIDENCE=3
ABSTAIN_BELOW_SCORE=0.15

# --- Multilingual (kept modular for Anuvadini/BHASHINI) ---
TRANSLATION_PROVIDER=none   # none | anuvadini | bhashini

# --- Re-ranking (optional, off by default) ---
# Only set to true if you're NOT on Render's free 512MB-RAM tier — the
# cross-encoder + sentence-transformers/torch dependency it pulls in will
# very likely OOM a free instance. See requirements.txt for the install note.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
