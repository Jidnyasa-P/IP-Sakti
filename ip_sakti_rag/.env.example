# ---------------------------------------------------------------------------
# IP-SAKTI RAG — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- LLM (optional; falls back to offline grounded synthesis if unset/invalid) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Vector store (Qdrant) ---
# Local mode (default, free, no server): leave QDRANT_URL empty and set a local path.
QDRANT_LOCAL_PATH=./data/qdrant_local
QDRANT_COLLECTION=ip_sakti_chunks
# Cloud mode (for deployment): set these instead and QDRANT_LOCAL_PATH will be ignored.
QDRANT_URL=
QDRANT_API_KEY=

# --- Re-ranking (optional, disable on very low-RAM free hosting) ---
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- TKDL (placeholder; leave false unless you have authorized TKDL access) ---
TKDL_ENABLED=false

# --- Knowledge graph (optional) ---
NEO4J_ENABLED=false
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# --- Retrieval tuning ---
SEMANTIC_WEIGHT=0.65
KEYWORD_WEIGHT=0.35
TOP_K=5

# --- Safety thresholds ---
CONFIDENCE_HIGH_THRESHOLD=0.45
CONFIDENCE_MODERATE_THRESHOLD=0.28
CONFIDENCE_LOW_THRESHOLD=0.15
MIN_CHUNKS_FOR_HIGH_CONFIDENCE=3
ABSTAIN_BELOW_SCORE=0.15

# --- Multilingual (kept modular for Anuvadini/BHASHINI) ---
TRANSLATION_PROVIDER=none   # none | anuvadini | bhashini
