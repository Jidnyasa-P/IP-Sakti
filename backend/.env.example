# =============================================================================
# IP-SAKTI Sahayak -- Backend Environment Configuration
# Copy this file to .env and fill in values. Every variable has a safe,
# clearly-labelled fallback ("DEMO MODE") if left blank.
#
# RAG (retrieval + LLM reasoning + knowledge graph + vector store) now lives
# entirely in the sibling `ip_sakti_rag` service -- configure that service's
# own .env (ip_sakti_rag/.env) separately. This backend only needs to know
# how to REACH it, via RAG_SERVICE_URL below.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Persistent application database ---
# MongoDB is the sole application datastore (conversations, chat messages,
# product analyses, saved research, expert escalations, audit records,
# feedback).
#
# Leave MONGODB_URI blank to run against an in-process, pymongo-API
# compatible in-memory store (DEMO MODE -- resets on every restart, zero
# setup needed). Set it to a real MongoDB to get a persistent database.
MONGODB_URI=
MONGODB_DB_NAME=ip_sakti

# --- RAG microservice (ip_sakti_rag) ---
# Point this at wherever ip_sakti_rag is running. Local dev default: 8001.
# On Render, set this to the deployed ip_sakti_rag service's URL.
RAG_SERVICE_URL=http://localhost:8001
# Must match ip_sakti_rag's RAG_SERVICE_SHARED_SECRET exactly (if that
# service has one configured). Leave both blank for local dev.
RAG_SERVICE_SHARED_SECRET=
RAG_SERVICE_TIMEOUT_SECONDS=30

# --- Multilingual / translation provider (UI strings; unrelated to RAG) ---
# Leave blank to use the local curated Hindi/Marathi statutory dictionaries.
TRANSLATION_PROVIDER=bhashini
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# --- Security ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
