# =============================================================================
# IP-SAKTI Sahayak — Backend Environment Configuration
# Copy this file to .env and fill in values. Every variable has a safe,
# clearly-labelled fallback ("DEMO MODE") if left blank, so the backend runs
# standalone with no external services for an SIH demo.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# --- Persistent application database (Section 22 / 33) ---
# MongoDB is the sole application datastore (conversations, chat messages,
# product analyses, saved research, classification/validation/audit
# records, feedback, expert escalations, admin-ingested documents).
#
# Leave MONGODB_URI blank to run against an in-process, pymongo-API
# compatible in-memory store (DEMO MODE — resets on every restart, zero
# setup needed). Set it to a real MongoDB to get a persistent database:
#   - `docker compose --profile full-stack up mongodb` -> mongodb://localhost:27017
#   - inside docker-compose's own network           -> mongodb://mongodb:27017
#   - MongoDB Atlas                                  -> mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=
MONGODB_DB_NAME=ip_sakti

# --- LLM reasoning provider (Section 20) ---
# Leave LLM_API_KEY blank to use the built-in DEMO MODE statutory-synthesis
# engine, which only assembles wording from the locally retrieved, cited
# evidence chunks — it never calls out to the internet and never invents law.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# --- Embeddings (Section 9) ---
# Leave blank to use the local TF-IDF/BM25 hybrid retriever (real, working,
# no external calls). Set to enable real semantic embeddings via the
# provider's embedding endpoint.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# --- Vector store (Section 9) ---
# Leave QDRANT_URL blank to use the built-in local in-process vector index
# (numpy + TF-IDF, persisted to backend/data/vector_index.json).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ip_sakti_chunks

# --- Knowledge graph (Section 16) ---
# Leave NEO4J_URI blank to use the built-in in-process NetworkX graph
# (real graph abstraction, persisted to backend/data/knowledge_graph.json).
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Multilingual / translation provider (Section 19) ---
# Leave blank to use the local curated Hindi/Marathi statutory dictionaries
# (ported from the existing frontend) as the DEMO MODE fallback.
TRANSLATION_PROVIDER=bhashini
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# --- Security ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
