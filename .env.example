# =============================================================================
# Root .env — only read by `docker compose` (see docker-compose.yml).
#
# For local (non-Docker) development, you don't need this file at all —
# use backend/.env instead (copy backend/.env.example -> backend/.env).
#
# Every variable below is optional. Leave everything blank to run in
# DEMO MODE: in-memory MongoDB mock + local TF-IDF retrieval + in-process
# knowledge graph + rule-based answer synthesis + curated translation
# dictionary. No external accounts, API keys, or databases required.
# =============================================================================

# --- Persistent app database (optional — blank = in-memory mock, zero setup) ---
# Point at MongoDB Atlas or the bundled `mongodb` service (--profile full-stack).
MONGODB_URI=
MONGODB_DB_NAME=ip_sakti

# --- Security (change JWT_SECRET before any real/shared deployment) ---
JWT_SECRET=change-me-in-production

# --- LLM reasoning provider (optional — blank = DEMO MODE synthesis) ---
LLM_API_KEY=

# --- Vector store (optional — blank = built-in local vector index) ---
QDRANT_URL=

# --- Knowledge graph (optional — blank = built-in in-process NetworkX graph) ---
NEO4J_URI=

# --- Multilingual translation (optional — blank = curated dictionary) ---
BHASHINI_API_KEY=
BHASHINI_USER_ID=
